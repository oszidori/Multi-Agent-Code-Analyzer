{
  "patterns": [
    {
      "id": "layered_architecture",
      "name": "Layered Architecture",
      "category": "system",
      "description": "Application organized into presentation, business and persistence layers.",
      "documentation_url": "https://martinfowler.com/bliki/LayeringPrinciples.html",
      "required": {
        "modules": ["controller", "service", "repository"]
      },
      "optional": {
        "technologies": ["spring boot", "asp.net core", "django"]
      }
    },
    {
      "id": "modular_monolith",
      "name": "Modular Monolith",
