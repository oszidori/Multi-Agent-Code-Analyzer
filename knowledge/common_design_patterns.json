      "description": "Single deployable application separated into business modules.",
      "documentation_url": "https://martinfowler.com/bliki/MonolithFirst.html",
      "required": {
        "keywords": ["module"]
      },
      "optional": {
        "modules": ["billing", "customer", "order", "inventory"]
      }
    },
    {
      "id": "microservices",
